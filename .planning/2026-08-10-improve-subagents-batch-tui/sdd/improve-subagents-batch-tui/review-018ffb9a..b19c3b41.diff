+test("done expanded: null (failed) slot has NO meta line (unchanged failed body)", () => {
+  const details: SubagentsToolDetails = {
+    results: [null, { output: "ok", status: "done", index: 1, task: "t", model: "zai/glm-5.2", elapsedMs: 100 }],
