+export function sumUsage(values: Iterable<AgentUsage>): { total: number; cost: number } {
+  let total = 0;
+  let cost = 0;
+  for (const v of values) {
+    total += v.total;
+    cost += v.cost;
+  }
+  return { total, cost };
+}
