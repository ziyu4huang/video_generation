+  const table = buildLiveTable(group);
+  const text = table ? `${header}\n${table}` : header;
+  onUpdate?.({
+    content: [{ type: "text" as const, text }],
+    details: undefined as never,
+  });
+} catch {
+  // swallowed — onUpdate is diagnostic only (mirrors the singular tool)
+}
+```
