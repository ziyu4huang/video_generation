+  });
+});
+
+describe("Task 6 — end-to-end smoke (capture → message_end → turn_end → markUsed)", () => {
+  it("a populated set + assistant output containing a signature → markUsed(sid, [mdId])", async () => {
+    const { pi, fire } = stubPi();
