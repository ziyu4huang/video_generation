+  if (writtenSecret.length) note(`set ${writtenSecret.length} GitHub secret(s): ${writtenSecret.join(" ")}`);
+  if (skipped.length) {
+    process.stdout.write("\n");
+    warn("still to do by hand:");
+    for (const s of skipped) note(`  - ${s}`);
+  }
+  process.stdout.write("\n");
+}
