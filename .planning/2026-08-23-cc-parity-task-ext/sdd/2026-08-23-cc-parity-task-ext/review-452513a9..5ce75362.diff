++  if (!isTTY) return;
++  process.stdout.write("\x1b[2J\x1b[3J\x1b[H");
++}
++
++// Shared line reader — queues whole lines so input that arrives ahead of a
++// question (piped stdin) is never swallowed. A TTY in cooked mode echoes by
++// itself, so no readline layer is needed.
++const lineQueue: string[] = [];
++let lineWaiter: ((line: string) => void) | undefined;
++let pending = "";
++let secretMode = false;
++
++function feedLine(line: string): void {
++  if (lineWaiter) {
++    const waiter = lineWaiter;
++    lineWaiter = undefined;
++    waiter(line);
++  } else {
++    lineQueue.push(line);
++  }
++}
