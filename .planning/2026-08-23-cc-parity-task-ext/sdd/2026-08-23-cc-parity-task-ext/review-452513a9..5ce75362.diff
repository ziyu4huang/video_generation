++  if (secretMode) return; // readSecret owns stdin while it's active
++  pending += chunk.toString("utf8");
++  let i = 0;
++  while (i < pending.length) {
++    const nl = pending.indexOf("\n", i);
++    if (nl === -1) break;
++    let end = nl;
++    if (end > i && pending[end - 1] === "\r") end--;
++    feedLine(pending.slice(i, end));
++    i = nl + 1;
++  }
++  pending = pending.slice(i);
++});
++process.stdin.on("end", () => {
++  feedLine(pending);
++  pending = "";
++  if (lineWaiter) feedLine(""); // exhausted input: stop blocking on it
++});
