++const C = {
++  bold: (s: string) => (isTTY ? `\x1b[1m${s}\x1b[0m` : s),
++  dim: (s: string) => (isTTY ? `\x1b[2m${s}\x1b[0m` : s),
++  blue: (s: string) => (isTTY ? `\x1b[34m${s}\x1b[0m` : s),
++  green: (s: string) => (isTTY ? `\x1b[32m${s}\x1b[0m` : s),
++  yellow: (s: string) => (isTTY ? `\x1b[33m${s}\x1b[0m` : s),
++};
