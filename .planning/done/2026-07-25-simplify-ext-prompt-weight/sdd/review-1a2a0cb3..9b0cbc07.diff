+
+describe("parseJudgeResult() — robust JSON extraction", () => {
+  it("parses a bare JSON object", () => {
+    expect(parseJudgeResult('{"scores":[3,2,1],"notes":"good"}')).toEqual({ scores: [3, 2, 1], notes: "good" });
