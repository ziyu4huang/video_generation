+    await expect(reopened.init()).resolves.toBeUndefined();
+    try {
+      const cols = reopened.getDb().prepare("PRAGMA table_info(session_assembly)").all() as Array<{ name: string }>;
+      const usedAtCount = cols.filter((c) => c.name === "used_at").length;
