+    const cfg = resolveDecayConfig({});
+    assert.strictEqual(cfg.halflifeDays, DEFAULT_DECAY_HALFLIFE_DAYS);
+    assert.strictEqual(cfg.worthWeight, DEFAULT_DECAY_WORTH_WEIGHT);
