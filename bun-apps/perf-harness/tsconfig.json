{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  // src only, deliberately. tests/grand-total.regression.test.ts deep-imports
  // sibling packages by relative path (../../../bun-apps/s2-agent-ext-*/…), and
  // tsc follows imports regardless of `include` — so listing tests/ here pulls
  // the whole transitive sibling graph in and typechecks it under THIS
  // package's compiler options rather than each package's own. That produced
  // 193 errors, none of them defects in this package: `moduleResolution:
  // Node16` flagging extensionless relative imports in obsidian, missing DOM
  // lib in others, and so on. Every one of those packages has its own
  // `typecheck` script with the right options. The tests themselves are gated
  // by `bun test` (this package's CI matrix row).
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
