{
  "name": "@repo/pi-agent-ext-movie-director",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: the movie-director orchestration layer — an instruction-driven (agent-first) video production pipeline rewriter. Pure Bun orchestration (pipeline manifest loader, gate-enforced checkpoints, artifact schema validation, cost tracker, tool registry) consuming the swift/MLX native directors (krea2/flux2/ltx) + ffmpeg/cloud providers. Rewrite of OpenMontage's Python orchestration.",
  "license": "MIT",
  "keywords": ["pi-package", "movie-director", "orchestration", "pipeline", "video", "mlx", "swift", "openmontage"],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "files": ["extensions", "src", "scripts", "data", "README.md"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check:schemas": "bun scripts/validate-data.ts",
    "cli": "bun src/cli.ts",
    "md": "bun src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "ajv": "latest",
    "ajv-formats": "latest",
    "msedge-tts": "^2.0.7",
    "yaml": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@repo/pi-agent-ext-flux2": "workspace:*",
    "@repo/pi-agent-ext-krea2": "workspace:*",
    "@repo/pi-agent-ext-ltx": "workspace:*",
    "@repo/pi-agent-ext-workflow": "workspace:*",
    "typebox": "*"
  },
  "devDependencies": {
    "@repo/pi-agent-ext-core-interface": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
