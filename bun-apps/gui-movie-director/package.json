{
  "name": "@repo/gui-movie-director",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "dev:watch": "bun run --watch server.ts",
    "dev:debug": "bun --inspect-wait --hot server.ts",
    "start": "bun run server.ts",
    "gui:port": "bun run scripts/gui-port.ts",
    "test": "bun run check:lint && bun test",
    "test:coverage": "bun test --coverage",
    "check:schema": "bun run scripts/check-schema.ts",
    "check:runtime": "bun run scripts/check-runtime.ts",
    "check:lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knowledge:scan": "bun run scripts/knowledge-cli.ts scan",
    "knowledge:extract": "bun run scripts/knowledge-cli.ts extract-captions",
    "knowledge:learn": "bun run scripts/knowledge-cli.ts learn",
    "code-knowledge": "bun run scripts/code-knowledge-cli.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.1"
  }
}
