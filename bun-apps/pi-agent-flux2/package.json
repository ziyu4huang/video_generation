{
  "name": "@repo/pi-agent-flux2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: wraps the swift/flux2-image-director CLI (flux2) as an agent-optimized tool. One dispatcher tool with typed per-command parameters, structured manifest parsing, progress streaming + abort, and path-safety guards.",
  "license": "MIT",
  "keywords": ["pi-package", "flux2", "image-generation", "mlx", "swift"],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "files": ["extensions", "src", "scripts", "README.md"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "build:bundle": "bun scripts/build-bundle.ts",
    "build:bundle:obf": "bun scripts/build-bundle.ts --obfuscate",
    "check:flags": "bun scripts/check-flags.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-agent-core": "latest",
    "pi-vlm": "workspace:*",
    "typebox": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
