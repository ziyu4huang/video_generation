{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun", "@repo/s2-agent-core-interface"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // No `noUncheckedIndexedAccess`: this package had no tsconfig at all until now,
    // and turning it on here would bury the entry-coverage fix under ~50 unrelated
    // index-access edits in the existing test suite. Adopting it is its own change.
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts"]
}
