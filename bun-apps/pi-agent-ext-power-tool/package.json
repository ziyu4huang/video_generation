{
  "name": "@repo/pi-agent-ext-power-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: power-tool suite. Includes context-analyzer (context window breakdown by component) + schema-cost (static tool-schema token accounting).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extensions/*": "./extensions/*",
    "./schema-cost": "./src/schema-cost/index.ts"
  },
  "pi": {
    "extensions": ["./src/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "example:schema-cost": "bun examples/schema-cost-quick.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "js-yaml": "latest",
    "typebox": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
