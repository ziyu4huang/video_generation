{
  "name": "@repo/s2-agent-ext-webui",
  "private": true,
  "version": "0.1.0",
  "description": "Pi extension: an optional loopback webui that co-drives one AgentSession with the TUI behind an agentic mutex \u2014 renders agent output (md/HTML views, live transcript) and routes user interaction (prompts, abort, HITL presentations) back through the same session.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test",
    "test": "bun run test:unit"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "marked": "^15",
    "playwright-core": "1.62.0-alpha-1783623505000"
  },
  "devDependencies": {
    "@repo/s2-agent-core-interface": "workspace:*",
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  }
}