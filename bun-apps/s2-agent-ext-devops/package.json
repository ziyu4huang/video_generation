{
  "name": "@repo/s2-agent-ext-devops",
  "private": true,
  "version": "0.1.0",
  "description": "DevOps tools \u2014 the tool-based devops chain (sync_default_branch / prepare_feature_branch / run_local_ci / merge_pr_after_local_ci / verify_merge_landed / sweep_merged_branches / check_main_health / retrospect / next-goal): local-CI-gated squash merges with structured JSON outcomes, no agent-side bash polling loops.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "devops",
    "gh",
    "ci",
    "pr-merge"
  ],
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "bin": {
    "ci-changed-packages": "./src/changed-packages-cli.ts",
    "devops-sync-default-branch": "./src/sync-default-branch-cli.ts",
    "devops-merge-pr-after-ci": "./src/merge-pr-after-ci-cli.ts",
    "devops-main-health": "./src/main-health-cli.ts",
    "devops-sweep-merged-branches": "./src/sweep-merged-branches-cli.ts",
    "devops-local-ci": "./src/local-ci-cli.ts",
    "devops-deploy": "./src/deploy-cli.ts",
    "devops-prepare-feature-branch": "./src/prepare-feature-branch-cli.ts",
    "devops-verify-merge": "./src/verify-merge-cli.ts",
    "devops-verify-deploy-e2e": "./src/verify-deploy-e2e-cli.ts",
    "devops-bump-version": "./src/version-bump-cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@repo/s2-agent-core-interface": "workspace:*"
  }
}