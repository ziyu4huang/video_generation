{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!.pi", "!vendor", "!tests/fixtures", "!__tests__/__fixtures__"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "useImportType": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "__tests__/**", "bench/**", "run-test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "warn"
          },
          "complexity": {
            "noBannedTypes": "warn"
          },
          "suspicious": {
            "noAssignInExpressions": "warn",
            "noTemplateCurlyInString": "warn",
            "noShadowRestrictedNames": "warn",
            "noImplicitAnyLet": "warn"
          }
        }
      }
    }
  ]
}
