    { "id": "stage", "lane": "prod", "col": 4, "type": "cloud", "label": "Stage", "sublabel": "canary 10 %" },
    { "id": "ship", "lane": "dev", "col": 5, "type": "cloud", "label": "Ship", "sublabel": "full rollout" },
