{
  "name": "decision",
  "description": "The evidence, then the call: the diagram (from `ir`) owns the top two-thirds, a decision sentence and the one reason it wins sit underneath. Use when one IR decides the argument.",
  "chrome": true,
  "slots": {
    "call": {
      "kind": "text",
      "required": true,
      "description": "the decision in one sentence — the slide's bottom line"
    },
    "why": {
      "kind": "text",
      "required": true,
      "description": "the one reason this call wins, in a few words"
    }
  },
  "roles": {
    "decisionCall": {
      "sizePt": 20,
      "bold": true,
      "color": "title"
    },
    "decisionWhy": {
      "sizePt": 13,
      "color": "muted"
    }
  },
  "body": [
    {
      "region": "content",
      "stack": {
        "dir": "row",
        "weights": [
          6,
          2,
          2
        ],
        "gap": 0.3
      },
      "children": [
        {
          "box": "fill",
          "content": {
            "kind": "diagram",
            "from": "{slide.ir}"
          }
        },
        {
          "box": "fill",
          "content": {
            "kind": "text",
            "role": "decisionCall",
            "from": "{slide.call}"
          },
          "align": "center",
          "valign": "middle"
        },
        {
          "box": "fill",
          "content": {
            "kind": "text",
            "role": "decisionWhy",
            "from": "{slide.why}"
          },
          "align": "center",
          "valign": "middle"
        }
      ]
    }
  ]
}
