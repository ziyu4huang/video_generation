{
  "name": "@repo/pi-agent-ext-tool-gate",
  "private": true,
  "version": "0.1.0",
  "description": "Dynamic Tool Gate — keeps core tools always active while gating heavy domain-specific tools (image/video/movie generation, document understanding, introspection, workflow orchestration, research, arxiv, production cost, z.ai web, deploy) behind prompt keyword matching. Reactivates instantly on keyword and stays active for the session.",
  "license": "MIT",
  "keywords": ["pi-package", "tool-gate", "token-optimization"],
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "test": "bun test",
    "qa:savings": "bun run qa/savings.ts",
    "qa:miss": "bun run qa/miss-rate.ts",
    "qa:miss-ab": "bun run qa/gate-recall.ts",
    "qa:gate-recall": "bun run qa/gate-recall.ts",
    "qa:coverage": "bun run qa/coverage.ts",
    "qa": "bun run qa/run.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "*"
  },
  "dependencies": {
    "@repo/pi-agent-core-interface": "workspace:*",
    "@repo/pi-agent-ext-power-tool": "workspace:*"
  },
  "devDependencies": {
    "@repo/pi-agent-ext-task": "workspace:*",
    "@repo/pi-agent-ext-devops": "workspace:*",
    "@repo/pi-agent-ext-file2md": "workspace:*",
    "@repo/pi-agent-ext-flux2": "workspace:*",
    "@repo/pi-agent-ext-hermes-memory": "workspace:*",
    "@repo/pi-agent-ext-knowledge-card": "workspace:*",
    "@repo/pi-agent-ext-krea2": "workspace:*",
    "@repo/pi-agent-ext-ltx": "workspace:*",
    "@repo/pi-agent-ext-movie-director": "workspace:*",
    "@repo/pi-agent-ext-obsidian": "workspace:*",
    "@repo/pi-agent-ext-research-tool": "workspace:*",
    "@repo/pi-agent-ext-subagent": "workspace:*",
    "@repo/pi-agent-ext-wayfind": "workspace:*",
    "@repo/pi-agent-ext-web-access": "workspace:*",
    "@repo/pi-agent-ext-workflow": "workspace:*",
    "@repo/pi-agent-ext-zai-mcp": "workspace:*"
  }
}
