{
  "name": "@repo/pi-agent-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained pi-agent CLI with pi-obsidian baked in. Agent commands (file2md, distill, knowledge, rag, pipeline pdf-to-vault) + pi-compatible passthrough.",
  "type": "module",
  "scripts": {
    "cli": "bun src/cli.ts",
    "zk-extract": "bun src/cli.ts zk-extract",
    "zk-card": "bun src/cli.ts zk-card",
    "zk-ask": "bun src/cli.ts zk-ask",
    "list": "bun src/cli.ts list",
    "postinstall": "[ -f node_modules/@repo/pi-agent-ext-workflow/dist/index.js ] || (cd node_modules/@repo/pi-agent-ext-workflow && bun run build)",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun scripts/build.ts",
    "build:watch": "bun --watch scripts/build.ts",
    "build:obf": "bun scripts/build.ts --obfuscate",
    "build:exe": "bun scripts/build.ts --compile",
    "build:all": "bun scripts/build.ts --all",
    "dist": "bun ../../dist/pi-agent-cli/cli.js",
    "exe": "./../../dist/pi-agent-cli/pi-agent-cli"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@repo/pi-agent-ext-workflow": "workspace:*",
    "@repo/pi-agent-ext-flux2": "workspace:*",
    "@repo/pi-agent-ext-krea2": "workspace:*",
    "@repo/pi-agent-ext-ltx": "workspace:*",
    "@repo/pi-agent-ext-movie-director": "workspace:*",
    "@repo/pi-agent-ext-power-tool": "workspace:*",
    "@repo/pi-agent-ext-research-tool": "workspace:*",
    "@repo/pi-agent-ext-subagent": "workspace:*",
    "@repo/pi-agent-ext-web-access": "workspace:*",
    "@repo/pi-agent": "workspace:*",
    "@repo/pi-agent-ext-knowledge-card": "workspace:*",
    "@repo/pi-agent-ext-obsidian": "workspace:*",
    "@repo/pi-agent-ext-file2md": "workspace:*",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "javascript-obfuscator": "^5.4.3"
  }
}
