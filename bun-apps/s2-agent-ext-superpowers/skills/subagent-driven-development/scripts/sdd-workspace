#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages, and
# the progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (<base>/<plan-basename>/) so a follow-up plan in the
# same working tree can never read or overwrite another plan's artifacts. A
# stale ledger misread as current progress makes controllers skip whole task
# sequences — plan-scoping removes that failure structurally.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Effort-aware (pi port): when PI_PLANNING_EFFORT is set, the base is
# $root/.planning/$effort/sdd — converging every SDD artifact under the same
# effort root as the spec/plan/tickets/map (no separate .superpowers/ tree),
# and the audit trail there is COMMITTED (only progress.md is transient,
# ignored by name at the repo level). With NO effort, falls back to flat
# $root/.planning/sdd (gitignored, local-only scratch; ADR-0007 — superpowers
# never writes under .superpowers/, unconditional). No effort subdir, so the
# single artifact home stays under .planning/ in both branches.
#
# Usage: sdd-workspace PLAN_FILE
#        PI_PLANNING_EFFORT=<effort> sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
effort="${PI_PLANNING_EFFORT:-}"

if [ -n "$effort" ]; then
  base="$root/.planning/$effort/sdd"
  mkdir -p "$base/$slug"
  # No blanket self-ignore under .planning/: the sdd audit trail is committed;
  # only progress.md is transient and is ignored by name at the repo level.
else
  base="$root/.planning/sdd"
  mkdir -p "$base/$slug"
  # Flat local-only scratch; ignored at the repo level (.gitignore: .planning/sdd/),
  # so no per-dir self-ignore is needed here (unlike the old upstream-faithful path).
fi

cd "$base/$slug" && pwd
