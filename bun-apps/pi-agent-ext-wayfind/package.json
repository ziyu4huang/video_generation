{
  "name": "@repo/pi-agent-ext-wayfind",
  "private": true,
  "version": "0.1.0",
  "description": "Pi-native port of Matt Pocock's decision-chain skill suite — grilling (relentless one-question-at-a-time interview), grill-me-with-docs (grilling + domain-modeling: writes CONTEXT.md glossary + ADRs inline), domain-modeling, wayfinder (chart a huge effort as a local-markdown map of decision tickets), to-spec, and to-tickets. Ships as a Layer-3 Pi extension: CSO-compliant skills + slash commands that kick off grilling/wayfinding sessions, and hands off resolved decisions -> a task_plan.md seed. Pure TypeScript, no Python, no shell scripts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "scripts": {
    "test": "bun run check && bun run test:unit",
    "test:unit": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "dev": "tsx src/index.ts",
    "architecture:render": "bun run src/architecture-render.ts",
    "architecture:vendor": "bun run scripts/vendor-mermaid.ts",
    "architecture:css": "bunx @tailwindcss/cli -i src/architecture.css -o vendor/tailwind.css --minify",
    "pretest": "bun run architecture:vendor"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "wayfinder",
    "grilling",
    "domain-modeling",
    "decision-making",
    "planning",
    "agent",
    "ai-agent",
    "llm",
    "matt-pocock"
  ],
  "pi": {
    "extensions": [
      "./extensions/wayfind.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "marked": "^15",
    "mermaid": "^11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@playwright/test": "^1",
    "@repo/pi-agent-core-interface": "workspace:*",
    "@tailwindcss/cli": "^4",
    "@types/bun": "^1.3.14",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  }
}
