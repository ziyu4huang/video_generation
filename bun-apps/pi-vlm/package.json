{
  "name": "pi-vlm",
  "version": "0.1.0",
  "description": "VLM document describer for pi: PDF/image → Obsidian markdown via a local Vision Language Model (LM Studio).",
  "license": "MIT",
  "keywords": ["pi-package", "vlm", "pdf", "obsidian", "lm-studio"],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "build:bundle": "bun scripts/build-bundle.ts",
    "build:bundle:obf": "bun scripts/build-bundle.ts --obfuscate"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
