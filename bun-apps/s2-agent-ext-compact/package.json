{
	"name": "@repo/s2-agent-ext-compact",
	"private": true,
	"version": "0.1.0",
	"description": "Claude Code-style /compact summaries via the session_before_compact hook, degrading to built-in compaction on any failure.",
	"license": "MIT",
	"keywords": ["pi-package", "compact"],
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./extensions/*": "./extensions/*",
		"./src/*": "./src/*",
		"./src/*.js": "./src/*.ts"
	},
	"pi": {
		"extensions": ["./extensions"]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"ab": "bun scripts/ab.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2"
	},
	"devDependencies": {
		"@repo/s2-agent-core-runtime": "workspace:*",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
