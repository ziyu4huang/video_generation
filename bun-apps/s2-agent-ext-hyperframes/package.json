{
  "name": "@repo/s2-agent-ext-hyperframes",
  "private": true,
  "version": "0.1.0",
  "description": "Pi extension: vendored HyperFrames skill family — 8 skills (7 hyperframes-* + media-use) from heygen-com/hyperframes. Ships skills only; the extension factory is a deliberate no-op that keeps the registration path uniform.",
  "keywords": ["pi-package", "hyperframes", "skills"],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extensions/*": "./extensions/*",
    "./src/*": "./src/*"
  },
  "pi": {
    "extensions": ["./extensions/hyperframes.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.4",
    "@hyperframes/producer": "0.8.4",
    "sharp": "0.34.5"
  }
}
