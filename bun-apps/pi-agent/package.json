{
  "name": "pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive pi TUI with monkey-patch hooks — forces model loading from .pi/agent/models.json, delegates everything else to the official pi main().",
  "type": "module",
  "bin": {
    "pi-agent": "src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "list": "bun src/cli.ts --list-models",
    "build": "bun scripts/build.ts",
    "build:exe": "bun scripts/build.ts --compile",
    "build:all": "bun scripts/build.ts --all",
    "dist": "bun ../../dist/pi-agent/pi-agent.js",
    "exe": "../../dist/pi-agent/pi-agent"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@juicesharp/rpiv-ask-user-question": "^1.20.0",
    "pi-hermes-memory": "^0.7.23"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
