{
  "name": "@repo/pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive pi TUI wrapper — injects a source-hardcoded provider catalog via a ModelRuntime.create monkey-patch, delegates everything else to the official pi main().",
  "type": "module",
  "piConfig": {
    "name": "pi-agent"
  },
  "exports": {
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "pi-agent": "src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "list": "bun src/cli.ts --list-models",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "regen:static": "bun scripts/regen-static-extensions.ts",
    "test:e2e": "PI_AGENT_E2E=1 bun test",
    "verify": "PI_AGENT_E2E=1 bun test src/__tests__/e2e-extensions.test.ts",
    "dist": "bun ../../dist/pi-agent/pi-agent.js",
    "exe": "../../dist/pi-agent/pi-agent",
    "//deploy": "4 modes — read docs BEFORE running: docs/deploy-cwd-trust.md (packaging + mode detection), docs/deploy-readonly.md (default chmod a-w freeze), docs/deploy-single-binary.md (--exe). Mode flags: --bundle (default), --snapshot, --standalone, --exe. Only --exe is fully self-contained/portable; the other three rely on a node_modules symlink into the machine-global bun store (same-machine only). Also see the mode table in scripts/deploy.ts header. Run via `bun run deploy[:mode]` from this dir. A FIFTH, independent pipeline lives at ../pi-agent-ext-devops/src/deploy-sh-cli.ts (`bun run deploy:sh`): versioned minimal-core deploy to ~/proj/dist/pi-agent-sh/<version>/ with extensions as separate packages under ext/ — see docs/deploy-sh.md.",
    "deploy": "bun ../pi-agent-ext-devops/scripts/deploy.ts",
    "deploy:bundle": "bun ../pi-agent-ext-devops/scripts/deploy.ts --bundle",
    "deploy:snapshot": "bun ../pi-agent-ext-devops/scripts/deploy.ts --snapshot",
    "deploy:standalone": "bun ../pi-agent-ext-devops/scripts/deploy.ts --standalone",
    "deploy:exe": "bun ../pi-agent-ext-devops/scripts/deploy.ts --exe",
    "deploy:sh": "bun ../pi-agent-ext-devops/src/deploy-sh-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@repo/pi-agent-ext-archify": "workspace:*",
    "@repo/pi-agent-core-runtime": "workspace:*",
    "@repo/pi-agent-ext-btw": "workspace:*",
    "@repo/pi-agent-ext-task": "workspace:*",
    "@repo/pi-agent-ext-devops": "workspace:*",
    "@repo/pi-agent-ext-file2md": "workspace:*",
    "@repo/pi-agent-ext-flux2": "workspace:*",
    "@repo/pi-agent-ext-hermes-memory": "workspace:*",
    "@repo/pi-agent-ext-hyperframes": "workspace:*",
    "@repo/pi-agent-ext-knowledge-card": "workspace:*",
    "@repo/pi-agent-ext-krea2": "workspace:*",
    "@repo/pi-agent-ext-ltx": "workspace:*",
    "@repo/pi-agent-ext-movie-director": "workspace:*",
    "@repo/pi-agent-ext-obsidian": "workspace:*",
    "@repo/pi-agent-ext-power-tool": "workspace:*",
    "@repo/pi-agent-ext-prompt-history": "workspace:*",
    "@repo/pi-agent-ext-research-tool": "workspace:*",
    "@repo/pi-agent-ext-subagent": "workspace:*",
    "@repo/pi-agent-ext-superpowers": "workspace:*",
    "@repo/pi-agent-ext-tool-gate": "workspace:*",
    "@repo/pi-agent-ext-wayfind": "workspace:*",
    "@repo/pi-agent-ext-web-access": "workspace:*",
    "@repo/pi-agent-ext-webui": "workspace:*",
    "@repo/pi-agent-ext-workflow": "workspace:*",
    "@repo/pi-agent-ext-zai-mcp": "workspace:*",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@repo/pi-agent-core-interface": "workspace:*",
    "@types/bun": "latest",
    "javascript-obfuscator": "^5.4.3",
    "typescript": "^7.0.2"
  }
}
