{
  "name": "@repo/pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive pi TUI with monkey-patch hooks — forces model loading from .pi/agent/models.json, delegates everything else to the official pi main().",
  "type": "module",
  "piConfig": {
    "name": "pi-agent"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "pi-agent": "src/cli.ts"
  },
  "scripts": {
    "deploy": "bun scripts/deploy.ts",
    "deploy:bundle": "bun scripts/deploy.ts --bundle",
    "deploy:snapshot": "bun scripts/deploy.ts --snapshot",
    "deploy:standalone": "bun scripts/deploy.ts --standalone",
    "deploy:exe": "bun scripts/deploy.ts --exe"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@repo/pi-agent-ext-goal-todo": "workspace:*",
    "@repo/pi-agent-ext-hermes-memory": "workspace:*",
    "@repo/pi-agent-ext-superpowers": "workspace:*",
    "@repo/pi-agent-ext-wayfind": "workspace:*",
    "@repo/pi-agent-ext-web-access": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
