{
  "name": "@repo/pi-agent-ext-file2md",
  "version": "0.1.0",
  "private": true,
  "description": "File→Markdown bridge for text-only agents: convert any PDF/image/doc to structured Markdown a pure-text agent can read, via a local vision-LLM subagent (LM Studio).",
  "license": "MIT",
  "keywords": ["pi-package", "file-to-markdown", "vision-llm", "vlm", "pdf", "obsidian", "lm-studio"],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "build:bundle": "bun scripts/build-bundle.ts --thin",
    "build:bundle:full": "bun scripts/build-bundle.ts",
    "build:bundle:no-obf": "bun scripts/build-bundle.ts --thin --no-obfuscate",
    "test": "bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "typebox": "*"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3"
  }
}
