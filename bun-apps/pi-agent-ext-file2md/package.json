{
  "name": "@repo/pi-agent-ext-file2md",
  "version": "0.1.0",
  "private": true,
  "description": "File→Markdown bridge for text-only agents: convert any PDF/image/doc to structured Markdown a pure-text agent can read, via a local vision-LLM subagent (LM Studio).",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "file-to-markdown",
    "vision-llm",
    "vlm",
    "pdf",
    "obsidian",
    "lm-studio"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./extensions/*": "./extensions/*"
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "build": "bun tsc",
    "build:bundle": "bun scripts/build-bundle.ts --thin",
    "build:bundle:full": "bun scripts/build-bundle.ts",
    "build:bundle:no-obf": "bun scripts/build-bundle.ts --thin --no-obfuscate",
    "test": "bun test --isolate"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@repo/pi-agent-ext-subagent": "workspace:*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@repo/pi-agent-ext-core-interface": "workspace:*",
    "@types/bun": "^1.3.14",
    "javascript-obfuscator": "^5.4.3",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mupdf": "^1.28.0"
  }
}
