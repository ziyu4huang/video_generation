{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["bun", "@repo/pi-agent-core-interface"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts"]
}
