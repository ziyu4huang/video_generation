{
  "name": "@repo/pi-agent-ext-devops",
  "private": true,
  "version": "0.1.0",
  "description": "DevOps tools \u2014 await_pr_merge / pr_status: a robust, tool-based PR-merge lifecycle that replaces brittle agent-side bash polling loops. Wraps the gh CLI (poll checks \u2192 enable --auto \u2192 on BEHIND rebase+force-push \u2192 wait for MERGED), with structured JSON (no grep -c footguns).",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "devops",
    "gh",
    "ci",
    "pr-merge"
  ],
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "bin": {
    "ci-changed-packages": "./src/changed-packages-cli.ts",
    "devops-sync": "./src/sync-cli.ts",
    "devops-pr-finish": "./src/pr-finish-cli.ts",
    "devops-main-health": "./src/main-health-cli.ts",
    "devops-sweep": "./src/sweep-cli.ts",
    "devops-local-ci": "./src/local-ci-cli.ts",
    "devops-prepare-branch": "./src/prepare-cli.ts",
    "devops-verify-merge": "./src/verify-merge-cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@repo/pi-agent-core-interface": "workspace:*"
  }
}