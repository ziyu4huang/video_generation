{
	"name": "@repo/pi-agent-ext-devops",
	"private": true,
	"version": "0.1.0",
	"description": "DevOps tools — await_pr_merge / pr_status: a robust, tool-based PR-merge lifecycle that replaces brittle agent-side bash polling loops. Wraps the gh CLI (poll checks → enable --auto → on BEHIND rebase+force-push → wait for MERGED), with structured JSON (no grep -c footguns).",
	"license": "MIT",
	"keywords": ["pi-package", "devops", "gh", "ci", "pr-merge"],
	"type": "module",
	"files": ["extensions", "src", "README.md"],
	"pi": {
		"extensions": ["./extensions"]
	},
	"bin": {
		"ci-changed-packages": "./src/changed-packages-cli.ts",
		"devops-sync": "./src/sync-cli.ts",
		"devops-pr-finish": "./src/pr-finish-cli.ts",
		"devops-verify-deploy": "./src/verify-deploy-cli.ts",
		"devops-main-health": "./src/main-health-cli.ts",
		"devops-sweep": "./src/sweep-cli.ts",
		"devops-local-ci": "./src/local-ci-cli.ts",
		"devops-prepare-branch": "./src/prepare-cli.ts",
		"devops-verify-merge": "./src/verify-merge-cli.ts"
	},
	"scripts": {
		"test": "bun test",
		"check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.2",
		"typebox": "*"
	},
	"devDependencies": {
		"@repo/pi-agent-ext-core-interface": "workspace:*",
		"@types/bun": "latest",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.84.2"
	}
}
