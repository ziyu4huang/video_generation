#!/bin/bash
# pre-push hook: run the CI `regression-gates` job locally before the push.
# Bypass with: git push --no-verify
#
# WHY THE WHOLE JOB, NOT JUST ONE AUDIT
#   This hook used to run scripts/test-portability-audit.sh --strict and nothing
#   else — one of the thirteen steps in that job. The other twelve (dep-direction,
#   seam, routing, config-parity, CI-workflow references, package-script
#   runnability, the determinism audit, PR-finish decision tests (now in
#   s2-agent-ext-devops), schema-cost)
#   had NO executor at all: GitHub Actions is disabled in this repo, so the job
#   they live in has not run in a long time, and `bun test` in a package never
#   reaches bun-apps/tests/. Guards nobody runs are guards that quietly stop
#   being true — that is how a `check` script that exits 127, a matrix row for a
#   deleted package, and a deploy flag that never existed all survived for
#   months. The whole job takes ~6s. There is no reason to run a thirteenth of it.
#   (Original ticket: wayfinder 2026-07-30-self-reflection-to-fix-these-error 01.)
#
# EXIT-CODE CONTRACT (ci-local.sh --gates)
#   0  every gate passed                          → push proceeds
#   4  python3 has no PyYAML on this machine      → WARN and fall back to the
#                                                   single audit this hook ran
#                                                   before, so a machine that
#                                                   cannot parse YAML is no worse
#                                                   off than it was
#   *  a gate failed, or the workflow would not   → BLOCK
#      parse
#
#   The 4 is why ci-local.sh propagates that code instead of collapsing it into
#   its generic failure exit: an environment problem and a real gate failure must
#   never be indistinguishable here. Getting that backwards in the lenient
#   direction would wave every genuine failure through.

# Drain the proposed-refs list git sends on stdin: the gates audit the whole
# tree, not the pushed refs.
cat >/dev/null

echo "→ CI regression-gates (13 steps, ~6s)…"
bash scripts/ci-local.sh --gates
code=$?

if [ $code -eq 0 ]; then
	exit 0
fi

if [ $code -eq 4 ]; then
	echo "· pre-push: python3 has no PyYAML — cannot parse the workflow." >&2
	echo "  Falling back to the test-portability audit alone (12 gates NOT run)." >&2
	echo "  Install it to get full local coverage: pip install pyyaml" >&2
	bash scripts/test-portability-audit.sh --strict || {
		echo "✗ pre-push blocked: UNGATED machine-coupled tests (P1/P2/P5)." >&2
		echo "  Wrap the test in *.skipIf(process.env.CI) or gate it behind an env" >&2
		echo "  opt-in (MLX_E2E / PI_AGENT_E2E / PI_RUN_L2). See" >&2
		echo "  .github/TEST-PORTABILITY.md.  Bypass: git push --no-verify" >&2
		exit 1
	}
	exit 0
fi

echo "" >&2
echo "✗ pre-push blocked: a CI regression gate failed (see the output above)." >&2
echo "  These are the guards that catch cross-package drift — a dead CI matrix" >&2
echo "  row, a package script that cannot run, a seam whose two sides disagree." >&2
echo "  Reproduce and iterate with:  bash scripts/ci-local.sh --gates" >&2
echo "  Bypass (and please say so in the PR):  git push --no-verify" >&2
exit 1
