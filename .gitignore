node_modules
# pi project-local runtime state. pi-agent itself does NOT generate this
# (run-dir/manifest npmExtensions is []; it loads extensions via absolute -e
# paths, never <cwd>/.pi). The .pi/npm/ dir is written only by pi CORE's
# DefaultPackageManager on an explicit project-scope `pi install` — ignore it
# so a stray install while cwd is in-repo can't pollute git status. Tracked
# hand-authored files (.pi/obsidian_config.json, .pi/agents/*.md) stay tracked.
.pi/agent/auth.json
.pi/agent/trust.json
**/.pi/npm/

# runtime artifacts — reviewer review reports (all context-dir variants:
# core-task / ext-task / task)
**/.pi/core-task/reviews/
**/.pi/ext-task/reviews/
**/.pi/task/reviews/

# Bun monorepo SOP — bun.lock at the root is the single canonical lockfile.
# Per-package npm lockfiles (package-lock.json) are NOT used here and must not
# be committed; they drift from bun.lock and confuse tooling. (pi-hermes-memory
# and pi-agent-ext-workflow shipped upstream npm lockfiles when vendored — removed.)
package-lock.json

# Dev-tool state dirs (Ralph interview state machine, etc.) — transient, never
# source. Stray ones came in vendored with pi-hermes-memory; ignored repo-wide.
.ralph/

# editor swap/backup files
*.swp
*.swo
*~
bun-apps/pi-agent-ext-workflow/docs/media/*.gif
.DS_Store
.claude/workflows/history/
.claude/workflows/*.operation-lessons.proposed.jsonl
.playwright-cli/
tmp/
python/mlx-movie-director/app/models/
# face-restore: facexlib hardcodes a 'gfpgan/weights' download dir (relative to
# cwd=repo root). Symlinked into app/models/face-restore (gitignored above) so
# weights aren't re-downloaded; this wrapper dir is itself an artifact.
/gfpgan/
.reasonix/
dist/

# Verify/checkpoint artifacts (generated summaries) and agent_inventory tool
# output (bun-apps/pi-agent-ext-power-tool) — both generated, not source.
/output/
/outputs/
/debug/
python/mlx-movie-director/vendor/mflux/
ComfyUI/
python/mlx-movie-director/vendor/ltx-2-mlx/
python/mlx-movie-director/vendor/ltx-2-mlx-dgrauet/
python/mlx-movie-director/vendor/ltx-2-mlx-acelogic/

# Swift build artifacts
swift/*/.build/
swift/*/.swiftpm/
*.xcuserstate

# Python bytecode caches
__pycache__/
*.py[cod]

# Swift parity-check reference dumps — real checkpoint tensors, large/regenerable
# via swift/ltx-video-director/scripts/dump_*_reference.py or python/mlx-movie-director/
# app/tests/gen_*_ref.py. Never commit raw safetensors (see CLAUDE.md model-import
# section) — matches swift/flux2-image-director/verify_refs/README.md's documented
# "regenerable dev-only fixtures, NOT committed" convention.
swift/*/test_refs/**/*.safetensors
swift/*/verify_refs/**/*.safetensors
pi-extensions

# Auto-generated by pi-obsidian fallback — vault lives at vaults_root/pi-agent-vault/
vault/

# Local env overrides (never commit) — see .env.example
.env

# pi-subagents runtime artifacts
.pi-subagents/

# No-effort SDD fallback (Option 1, ADR-0007): flat local-only scratch; effort
# SDD (.planning/<effort>/sdd/) stays committed. This pattern matches ONLY the
# flat dir, not the effort-scoped subtree.
.planning/sdd/

# Legacy superpowers scratch (.superpowers/sdd/ + .superpowers/brainstorm/).
# Routed under .planning/<effort>/{sdd,brainstorm}/ when PI_PLANNING_EFFORT is
# set (effort-aware scripts); the no-effort SDD fallback now lands under
# .planning/sdd/ (see above), so this ignore is pure defense-in-depth for any
# upstream reference / legacy scratch so it never pollutes git status.
.superpowers/

# Planning artifacts under .planning/<effort>/ are durable, shared, and persist
# across sessions — they ARE committed. This includes:
#   - wayfinder decision maps + tickets (top-level <effort>/*.md, plans/)
#   - SDD audit trail: <effort>/sdd/{briefs,reports,reviews}/
#     (task briefs, implementer reports, review diff packages)
# Only per-task TRANSIENT scratch stays ignored (matched by filename, anywhere):
task_plan.md
progress.md
findings.md

# python/embed-bench: isolated venv + generated benchmark output
python/embed-bench/.venv/
python/embed-bench/results/

# Vendored mermaid UMD bundle — ~3.4 MiB, regenerated at build time by
# `architecture:vendor` (copies node_modules/mermaid/dist/mermaid.min.js).
# Sourced from npm (runtime dep of @repo/pi-agent-ext-wayfind); never committed
# because it exceeds the repo's 2 MB pre-commit guard. vendor/tailwind.css (the
# curated static Tailwind build, ~20 KB) IS still committed — only this binary
# is ignored.
bun-apps/pi-agent-ext-wayfind/vendor/mermaid.min.js
