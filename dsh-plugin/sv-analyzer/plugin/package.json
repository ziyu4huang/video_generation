{
  "name": "dsh-sv-analyzer",
  "version": "0.2.1",
  "description": "Self-contained tree-sitter WASM analyzer for Verilog/SystemVerilog: sv_analyze (design summary) and sv_ast (parse tree) tools for the DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "wasm/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tree-sitter",
    "verilog",
    "systemverilog",
    "wasm"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
