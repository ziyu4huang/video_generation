# pi-* packages — portability-relevant environment variables.
# Copy to `.env` (or export in your shell). Full reference:
#   docs/pi-cross-machine-setup.md
# Run `bun bun-apps/pi-agent/src/cli.ts cli doctor` to self-check.

# --- LLM provider / model (all packages) --------------------------------------
# PI_PROVIDER=zai              # provider name (zai, lm-studio, ...)
# PI_MODEL=provider/id[:thinking]
# PI_THINKING=off              # off|minimal|low|medium|high|xhigh

# --- MLX generation paths (pi-agent-ext-flux2 + mlx-movie-director) ---------------
# Defaults are relative to the repo root; set these on a fresh machine if your
# model tree / output store aren't siblings of the repo.
# MLX_OUTPUT_DIR=/path/to/video_generation__output   # write target (auto-created)
# MLX_MODELS_DIR=/path/to/mlx-models                 # read target (must exist)

# --- flux2 (pi-agent-ext-flux2) ---------------------------------------------------
# FLUX2_BIN=/path/to/flux2          # prebuilt binary (skip discovery + swift build)
# FLUX2_REPO_ROOT=/path/to/repo     # repo root (needed in bundle/binary mode)

# --- Obsidian vault (pi-obsidian, pi-knowledge-card) --------------------------
# OB_VAULT_PATH=/abs/path/to/vault  # absolute vault path (overrides everything)
# OB_VAULT_DIR=vault                # vault folder name under cwd (Tier 3 fallback)
# OB_INDEX_CACHE_DIR=/path/to/cache # search-index persistence (relocatable)

# --- VLM (pi-file2md) — local LM Studio ------------------------------------------
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio

# --- pi-agent core ------------------------------------------------------------
# PI_CODING_AGENT_DIR=~/.pi/agent   # where pi reads/writes settings, models, agents
