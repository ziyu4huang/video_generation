# CI — the PR gate. Turns the manual-test trust model into an enforced gate.
#
# Every PR to main runs the Bun test suite (28 packages — one matrix row per
# bun-apps/* workspace package, i.e. complete coverage; smart-routed by
# changed_packages — see that job's comment), the extension contract test, the
# deploy-mode e2e + read-only contract + compiled-binary smoke (deploy-verify /
# compile-verify), and the regression baselines (schema-cost + 2 MB file-size
# guard + lockfile duplicate-version guard). Push-to-main always runs every
# package unconditionally, same precedent as deploy-verify.
# Machine-coupled tests (probing the
# local Apple-Silicon generation stack: python/venv, built swift binaries,
# run.py) skip under CI=true (set automatically by GitHub Actions) — see
# .github/CI.md for what's tested vs. deferred and how to re-run locally.
#
# GPU / Metal / sibling-fork (mflux, ltx-2-mlx) tests are intentionally NOT here:
# GitHub Actions runners lack Apple Silicon. Those stay local-only (documented).
name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

# Cancel superseded runs on the same ref (PR pushed again → kill the old run).
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ──────────────────────────────────────────────────────────────────────────
  # Smart test routing — computes which bun-apps/* packages actually need to
  # re-run given the changed files, so a PR touching one package's tests
  # doesn't pay for all 28 matrix entries below. push-to-main always runs
  # everything (same "can't skip on the branch that ships" precedent as
  # check-deploy-paths further down).
  #
  # The filter needs NO per-package maintenance: it DISCOVERS the package set by
  # listing bun-apps/*/package.json and reads the @repo/* dependency graph live,
  # so adding/removing a matrix row above requires no edit here. (Algorithm:
  # live @repo/* graph, reverse-BFS propagation, fails OPEN to "run everything"
  # on any change outside a known bun-apps/<pkg>/ path.)
  #
  # The implementation lives in the devops extension package
  # (bun-apps/pi-agent-ext-devops/src/changed-packages.ts — the TS port of the
  # retired scripts/ci-changed-packages.sh), invoked through the thin CLI wrapper
  # src/changed-packages-cli.ts. Same argv contract the bash had (`--all`, or
  # `<baseRef> <headRef>`) and the same single-line JSON on stdout, so this step
  # is unchanged apart from the command. The wrapper imports only node builtins +
  # its own spawn seam, which is why this job sets up Bun ALONE (no setup-env /
  # bun install): it must stay a seconds-long pre-flight for the 28-row matrix.
  # Gating lives on the `tests` job's STEPS, not the job itself —
  # `matrix` context isn't available in a job-level `if:` (only github/needs/
  # vars/inputs are; actionlint catches this, plain YAML parsing does not).
  # Every "test · <package>" job/check still always exists and reports for
  # every PR — unaffected packages just no-op through skipped steps.
  # ──────────────────────────────────────────────────────────────────────────
  changed_packages:
    name: changed packages
    runs-on: ubuntu-latest
    timeout-minutes: 2
    outputs:
      packages: ${{ steps.filter.outputs.packages }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # Bun only — deliberately NOT ./.github/actions/setup-env. The CLI wrapper
      # needs no installed workspace (node:fs / node:path + a `git` spawn), and
      # every downstream job waits on this one.
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.3.14"
      # The path is spelled out in full on BOTH branches rather than hoisted into
      # a shell variable: bun-apps/tests/ci-workflow-references.test.ts resolves
      # every literal script path this workflow names, and an indirection through
      # `$CLI` would hide it from that guard — which is precisely how the
      # reference this step replaced rotted unnoticed.
      - id: filter
        run: |
          if [ "${{ github.event_name }}" = "push" ]; then
            json=$(bun bun-apps/pi-agent-ext-devops/src/changed-packages-cli.ts --all)
          else
            json=$(bun bun-apps/pi-agent-ext-devops/src/changed-packages-cli.ts "${{ github.event.pull_request.base.sha }}" "${{ github.event.pull_request.head.sha }}")
          fi
          echo "packages=$json" >> "$GITHUB_OUTPUT"

  # ──────────────────────────────────────────────────────────────────────────
  # Thrust A — the core test gate. One matrix entry per package → native
  # per-package pass/fail in the PR checks UI (a broken package goes red by
  # name). fail-fast:false so every package reports even if one fails. Each
  # entry's `if:` is gated by changed_packages — see that job's comment.
  # ──────────────────────────────────────────────────────────────────────────
  tests:
    name: test · ${{ matrix.package }}
    needs: changed_packages
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        include:
          # typecheck folded in: bun's transpiler skips tsc, so 0.80.10 cast-rule
          # / private-member drift in src/patches/* once landed ungated (PR #620
          # postmortem). tsc --noEmit keeps SDK-internal patches type-honest.
          - { package: pi-agent, test-cmd: "bun test && bun run typecheck" }
          # ── uniform `bun test` runner ──
          - { package: pi-agent-ext-flux2, test-cmd: "bun test" }
          - { package: pi-agent-ext-krea2, test-cmd: "bun test" }
          - { package: pi-agent-ext-ltx, test-cmd: "bun test" }
          - { package: pi-agent-ext-movie-director, test-cmd: "bun test" }
          - { package: pi-agent-ext-power-tool, test-cmd: "bun test" }
          # skills-only carrier (vendored HyperFrames family): its `test`
          # script is scoped to tests/ so upstream's vendored .test.mjs in
          # skills/ (machine-coupled, byte-identical upstream content) never
          # runs — the portability audit likewise excludes */skills/*.
          - { package: pi-agent-ext-hyperframes, test-cmd: "bun run test" }
          - { package: pi-agent-ext-btw, test-cmd: "bun test" }
          - { package: pi-agent-ext-task, test-cmd: "bun test" }
          - { package: pi-agent-ext-research-tool, test-cmd: "bun test" }
          - { package: pi-agent-ext-zai-mcp, test-cmd: "bun test" }
          # pi-agent-ext-tool-gate: unit tests + the encoded QA verdict gate
          # (`bun run qa` — savings floor ≥15%+2k ∧ L1 intended-behavior; exits
          # non-zero on regression, per the prior QA effort's encoded thresholds
          # in qa/run.ts). Was missing from the matrix entirely — its 8 test
          # files never ran in CI. The telemetry-emit test is hermetic to
          # TOOL_GATE_LOG_PATH (beforeEach snapshot/delete/restore, matching the
          # hermes config.test.ts PR #938 pattern) so the harness exporting that
          # var in live sessions doesn't flake it.
          - { package: pi-agent-ext-tool-gate, test-cmd: "bun test && bun run qa" }
          # --isolate: render-bin-missing / delta-bin-missing use mock.module on
          # ../lib/run.ts; without per-file process isolation the stub leaks into
          # run.test.ts (same pattern as pi-agent-ext-knowledge-card e2e below).
          - { package: pi-agent-ext-archify, test-cmd: "bun test --isolate" }
          - { package: perf-harness, test-cmd: "bun test" }
          # wayfind's own `test` script chains check(biome) → build(tsc) →
          # test:unit(bun test); `bun run test` (not plain `bun test`) so that
          # full chain runs, matching gui-movie-director's convention below.
          # Was KNOWN RED through 2026-08-12 (useTemplate drift in
          # src/__tests__/settings.test.ts from #1228). Fixed — the lint was
          # fixed rather than the row weakened, as that note demanded. Green as
          # of the ci-local.sh matrix run.
          - { package: pi-agent-ext-wayfind, test-cmd: "bun run test" }
          - { package: pi-agent-ext-superpowers, test-cmd: "bun run test" }
          - { package: pi-agent-ext-web-access, test-cmd: "bun test" }
          # pi-agent-core-interface: the cross-extension seam contract
          # (__piCoreTaskStatusWidget key + shape). 2 test files that had never
          # been in the matrix — the static seam guard in `regression gates`
          # covers the publisher/consumer drift, but nothing ran this package's
          # OWN tests.
          - { package: pi-agent-core-interface, test-cmd: "bun test" }
          # pi-agent-core-runtime: extracted from pi-agent-ext-subagent in
          # #1251 (decouples workflow -> subagent). The extraction moved 10 test
          # files into a NEW package, and a new package is invisible to a matrix
          # that lists packages by hand — so those 10 files silently left CI the
          # moment they moved. Uses the package's plain `bun test`.
          - { package: pi-agent-core-runtime, test-cmd: "bun test" }
          # pi-agent-ext-devops: 17 test files (local-CI recipe, changed-packages
          # port, deploy/gh/branch/sync recipes) that had never been in the
          # matrix. Notably it owns src/changed-packages.ts + its CLI wrapper —
          # the code the `changed_packages` job above shells out to — so CI's own
          # routing logic was untested by CI. Plain `bun test` (its `check`
          # script is tsc --noEmit only).
          - { package: pi-agent-ext-devops, test-cmd: "bun test" }
          # pi-agent-ext-prompt-history: 2 test files, never in the matrix. It is
          # one of the statically-bundled extensions compile-verify asserts on
          # (see that job's 13-extension list), so a break here ships straight
          # into the compiled binary. Plain `bun test`.
          - { package: pi-agent-ext-prompt-history, test-cmd: "bun test" }
          # --isolate: classify-vlm/ask-io/vlm-ask-tool/pipeline mock.module()
          # sessions.ts + vision-inference.ts; without per-file process isolation
          # the stub leaks into sessions.test.ts / resolve-vision-llm.test.ts
          # (same pattern as pi-agent-ext-archify above).
          - { package: pi-agent-ext-file2md, test-cmd: "bun test --isolate" }
          # gui-movie-director: lint is pure static analysis (CI-safe); the
          # check-runtime suite probes run.py via the venv and skips under CI.
          # `typecheck` is chained (as pi-agent does) AND now exists as a script:
          # this package had no tsc key at all, so main_health reported
          # `typecheck: {skipped: true, note: "no tsc key"}` — which reads as
          # benign — while `tsc --noEmit` by hand produced 133 errors, among them
          # a dropped `hint` that kept a GPU-crash warning off the screen.
          - { package: gui-movie-director, test-cmd: "bun run test && bun run typecheck" }
          # ── scoped test paths (plain `bun test` discovers vault-needing
          #    files outside extensions/__tests__ in pi-agent-ext-obsidian) ──
          # Run order matters: e2e uses --isolate (avoids mock.module leak),
          # then toolWiring.test.mjs runs LAST so its mock.module() leak
          # never afflicts sibling files (see CLAUDE.md mock.module note).
          - { package: pi-agent-ext-knowledge-card, test-cmd: "bun test __tests__/e2e-orchestration.test.ts --isolate && bun test __tests__/allowlists.test.mjs __tests__/ingest.test.ts __tests__/merge.test.ts __tests__/emit.test.ts __tests__/similarity.test.ts __tests__/retrieve.test.ts __tests__/pi-knowledge-card.test.ts __tests__/blend.test.ts && bun test __tests__/toolWiring.test.mjs" }
          - { package: pi-agent-ext-obsidian, test-cmd: "bun test extensions/__tests__/" }
          # ── special runners (see CLAUDE.md testing section) ──
          # pi-agent-ext-workflow: src-entry package since the 2026-08-15
          # src-entry migration (ticket 04): root resolves to ./src/index.ts,
          # no build step; the generic canonical chain (check && test:unit) is
          # the gate — biome check passes clean (warnings only; the old
          # formatting-drift note is stale).
          - { package: pi-agent-ext-workflow, test-cmd: "bun run test" }
          # pi-agent-ext-webui: 21 test files, never in the matrix — the largest
          # single uncovered suite in the repo. Src-entry package since the
          # 2026-08-15 src-entry migration (ticket 02, PR #1391): package root
          # resolves to ./src/index.ts, no build step, dist/ deleted — a plain
          # `bun test` runs from source on any checkout.
          - { package: pi-agent-ext-webui, test-cmd: "bun test" }
          # pi-agent-ext-subagent: extracted from workflow (spawnSubagent +
          # WorkflowAgent runner + subagent/subagent_runs tools). Uses the
          # package's canonical `bun run test` chain (biome check → tsc build →
          # bun test), mirroring wayfind's `bun run test` convention.
          # Was KNOWN RED through 2026-08-12 with 17 biome errors
          # (noUnusedVariables in src/subagents-command.ts from #1013,
          # noNonNullAssertion in tests/install-subagent-context-widget.test.ts
          # from #1078). Fixed — the lint was fixed rather than the row
          # weakened. Green as of the ci-local.sh matrix run.
          - { package: pi-agent-ext-subagent, test-cmd: "bun run test" }
          # pi-agent-ext-hermes-memory: pure `bun test` (Bun-only package —
          # uses bun:sqlite via the BunCompatDatabase shim in src/store/db.ts;
          # better-sqlite3/Node support was removed). The historical tsx/Node
          # carve-out (tests/run-all.sh) is retired: the corruption-recovery
          # test's build-dependent row count was made build-agnostic (asserts the
          # recovery CONTRACT, not an exact count — see db.test.ts + D3 in
          # .github/TEST-DETERMINISM.md), so `bun test` is now the gate on every
          # platform. No Node setup needed.
          - { package: pi-agent-ext-hermes-memory, test-cmd: "bun test" }

    # `matrix` context is NOT available in a job-level `if:` (only github/
    # needs/vars/inputs are — see the context-availability table; actionlint
    # catches this, a local YAML parse does not, since the file is
    # syntactically valid YAML and only GitHub's expression-schema check
    # rejects it, at push/PR time with zero check-runs created). So the
    # affected-package gate lives on the STEPS below instead, where `matrix`
    # IS available — every job instance (= every "test · <package>" check)
    # still always exists and reports (its steps just no-op when the package
    # isn't affected), which is what required-status-checks needs anyway.
    steps:
      # "should this instance's steps actually run" — repeated verbatim on
      # every step below (YAML aliases can't be string-concatenated inline
      # with `&&`, so this comment is the single source of truth to keep them
      # in sync, not a real anchor).  !cancelled() so an actually-cancelled
      # run still stops cleanly; the needs.changed_packages.result check
      # fails OPEN (runs everything) if that job itself errored, rather than
      # silently skipping every package the way an unguarded `needs` failure
      # would.
      - uses: actions/checkout@v4
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
      # Shared preamble (Bun + install + build pi-agent-ext-workflow). Every
      # matrix entry is now pure Bun (hermes-memory dropped its Node/tsx carve-out).
      - uses: ./.github/actions/setup-env
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"

      # movie-director's preflight test probes ffmpeg on PATH (the composition
      # runtime). ubuntu-latest doesn't ship it; install only for that matrix
      # entry. (compose.test.ts uses mocked ffmpeg; e2e.local is opt-in.)
      - name: Install ffmpeg (movie-director preflight probe)
        if: "matrix.package == 'pi-agent-ext-movie-director' && !cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
        run: sudo apt-get update && sudo apt-get install -y ffmpeg

      - name: Test
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
        working-directory: bun-apps/${{ matrix.package }}
        env:
          # Set automatically by GitHub Actions; the signal machine-coupled
          # tests use to skip (no venv / Metal / swift build on this runner).
          CI: "true"
        run: ${{ matrix.test-cmd }}

  # ──────────────────────────────────────────────────────────────────────────
  # Thrust B — extension contract as a NAMED, visible check (not buried in the
  # pi-agent test run). The 5 tests gate every manifest extension: factory
  # loads, wires up, no tool-name conflicts, valid schema, handler present.
  # Path-gated on check-deploy-paths (same condition as deploy-verify/
  # compile-verify below — a change inside pi-agent itself OR one of the 5
  # statically-imported "core" extension packages can affect this) so PRs
  # untouched by any of them don't pay for it.
  # ──────────────────────────────────────────────────────────────────────────
  extension-contract:
    name: extension-contract
    needs: check-deploy-paths
    if: needs.check-deploy-paths.outputs.deploy == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup-env
      - name: Extension contract (5 tests)
        working-directory: bun-apps/pi-agent
        run: bun test src/__tests__/extension-contract.test.ts

  # ──────────────────────────────────────────────────────────────────────────
  # Pre-check: does this PR touch bun-apps/pi-agent/, or one of the 5 "core"
  # (statically-imported) extension packages? Push-to-main always runs. Gates
  # extension-contract, deploy-verify, AND compile-verify below.
  # Also matches the 5 "core" extension packages that src/static-extensions.ts
  # statically imports into every pi-agent deploy mode (see run-dir/
  # manifest.json's `staticExtensions` field) — a change to any of THEIR
  # source is just as capable of breaking a pi-agent deploy/binary as a change
  # inside bun-apps/pi-agent/ itself, since their code is inlined directly
  # into pi-agent.js / the compiled binary, not loaded as an independent
  # jiti-dispatched extension.
  check-deploy-paths:
    runs-on: ubuntu-latest
    timeout-minutes: 2
    outputs:
      deploy: ${{ steps.filter.outputs.deploy }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - id: filter
        run: |
          PATTERN='^bun-apps/pi-agent/|^bun-apps/pi-agent-ext-(task|hermes-memory|superpowers|wayfind|web-access)/'
          if [ "${{ github.event_name }}" = "push" ]; then
            echo "deploy=true" >> "$GITHUB_OUTPUT"
          elif git diff --name-only ${{ github.event.pull_request.base.sha }}...${{ github.event.pull_request.head.sha }} | grep -qE "$PATTERN"; then
            echo "deploy=true" >> "$GITHUB_OUTPUT"
          else
            echo "deploy=false" >> "$GITHUB_OUTPUT"
          fi

  # ──────────────────────────────────────────────────────────────────────────
  # Thrust B — deploy-mode e2e + read-only contract. Runs run-test.sh's `high`
  # tier (deploys + probes extension loading across bundle/snapshot/standalone,
  # per-mode doctor/--smoke/skill-load — see src/__tests__/e2e-extensions.test.ts)
  # and `readonly` tier (frozen-tree zero-write contract across bundle +
  # snapshot — see src/__tests__/e2e-readonly.test.ts). Catches resolve.ts
  # mode bugs, broken bundles, and read-only-deploy regressions at DEPLOY time.
  # (Previously a one-off `deploy.ts --writable --verify` call; deploy.ts no
  # longer has a --verify flag — reusing the same suite `./run-test.sh` runs
  # locally means CI and local dev never drift out of sync on what "verified"
  # means.) Path-gated to bun-apps/pi-agent/ + the 5 core extension packages
  # (unconditionally on push-to-main) so it doesn't delay PRs untouched by them.
  # ──────────────────────────────────────────────────────────────────────────
  deploy-verify:
    needs: check-deploy-paths
    if: needs.check-deploy-paths.outputs.deploy == 'true'
    name: deploy -- verify
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup-env
      - name: Deploy-mode e2e (bundle/snapshot/standalone × doctor/smoke/skill-load)
        working-directory: bun-apps/pi-agent
        run: ../pi-agent-ext-devops/scripts/run-test.sh high
      - name: Read-only deploy contract (frozen tree, zero writes)
        working-directory: bun-apps/pi-agent
        run: ../pi-agent-ext-devops/scripts/run-test.sh readonly

  # ──────────────────────────────────────────────────────────────────────────
  # compile-verify — builds the standalone `bun build --compile` binary and
  # smoke-tests it. Before this job, NOTHING in CI ever built or ran the
  # compiled binary (deploy-verify above only exercises bundle mode); the
  # binary previously shipped with ZERO extensions with no regression
  # coverage catching it. Checks: (1) the binary boots and `doctor --json`
  # reports ok:true (entry/mode/providers/patches all healthy in binary
  # mode); (2) the 13 statically-bundled extensions (6 productivity:
  # ext-task/hermes-memory/prompt-history/superpowers/wayfind/web-access + 7 tool-providing:
  # obsidian/btw/file2md/subagent/workflow/knowledge-card/power-tool — see src/static-extensions.ts)
  # register cleanly, via `ext doctor` in source
  # mode (the compiled binary's own `ext doctor` subcommand isn't binary-
  # mode-aware — it resolves paths via import.meta.url, which is the $bunfs
  # virtual scheme in binary mode — so this checks the same static factories
  # the binary embeds, just through the source-mode entry point); (3) the 4
  # binarySkills dirs resolve to real `--skill` paths next to the exe; (4)
  # the 5 newly-bundled tool extensions (obsidian et al.) ARE inlined into
  # the binary — `strings` finds obsidian's module body, proving the static
  # imports ship in the single-file exe (previously these were `external`'d
  # out in bun-apps/pi-agent-ext-devops/scripts/deploy.ts to scope to 5; now deliberately bundled → 12, so
  # PRESENCE is the invariant, not absence);
  # (5) the exe is a genuine single file — copied ALONE to an empty,
  # unrelated directory (no dist/pi-agent/ siblings), it still boots and
  # `doctor --json` reports ok:true (the whole point of `--exe`'s embedded
  # theme/skills/assets over the old --compile's 7 companion dirs).
  # Path-gated same as deploy-verify — both only exercise pi-agent's surface.
  # ──────────────────────────────────────────────────────────────────────────
  compile-verify:
    needs: check-deploy-paths
    if: needs.check-deploy-paths.outputs.deploy == 'true'
    name: compile -- verify
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup-env
      - name: Build standalone binary
        working-directory: bun-apps/pi-agent
        run: bun run deploy:exe
      - name: Smoke — binary boots + doctor reports healthy
        working-directory: bun-apps/pi-agent
        run: |
          set -e
          ../../dist/pi-agent/pi-agent --version
          ../../dist/pi-agent/pi-agent doctor --json | tee /tmp/doctor.json
          python3 -c "import json,sys; d=json.load(open('/tmp/doctor.json')); sys.exit(0 if d['ok'] else 1)"
      - name: Smoke — exe is a genuine single file (boots alone in an empty dir)
        working-directory: bun-apps/pi-agent
        run: |
          set -e
          mkdir -p /tmp/pi-agent-single-exe-test
          cp ../../dist/pi-agent/pi-agent /tmp/pi-agent-single-exe-test/
          cd /tmp/pi-agent-single-exe-test
          ./pi-agent --version
          ./pi-agent doctor --json | tee /tmp/single-exe-doctor.json
          python3 -c "import json,sys; d=json.load(open('/tmp/single-exe-doctor.json')); sys.exit(0 if d['ok'] else 1)"
      - name: Smoke — every statically-bundled extension registers (ext doctor, source mode)
        working-directory: bun-apps/pi-agent
        run: |
          set -e
          bun src/cli.ts ext doctor --json | tee /tmp/ext-doctor.json
          python3 -c "
          import json
          # Compare against the MANIFEST, never a literal count. This assertion
          # used to read 'assert len(statics) == 13' and had been wrong (the set
          # is 14) for long enough that nobody noticed — Actions are disabled, so
          # it would have failed on the day they were switched back on. The
          # static-extension count drifted independently in six places for the
          # same reason: a number restated by hand is a number that rots.
          d = json.load(open('/tmp/ext-doctor.json'))
          manifest = json.load(open('run-dir/manifest.json'))
          expected = set(manifest['staticExtensions'])
          statics = [e for e in d['entries'] if e['bundleMode'] == 'static']
          got = {e['name'] for e in statics}
          assert got == expected, f'static set != manifest.staticExtensions; missing={expected-got} unexpected={got-expected}'
          failed = [e['name'] for e in statics if e['status'] == 'FAIL']
          assert not failed, f'static extension(s) failed to register: {failed}'
          print(f'{len(statics)}/{len(expected)} static extensions OK:', sorted(got))
          "
      - name: Smoke — binarySkills resolve to real --skill paths
        working-directory: bun-apps/pi-agent
        run: |
          set -e
          # Grep the resolver's own summary line, not a raw "--skill" count —
          # --help's own usage text also mentions the --skill FLAG itself,
          # which inflates a naive count.
          BUN_PI_DEBUG_RUN_DIR=1 ../../dist/pi-agent/pi-agent --help 2>&1 | grep -q "emitting 4 --skill flag(s)" \
            || { echo "expected resolve.ts to emit exactly 4 --skill flags in binary mode"; exit 1; }
      - name: Verify the 5 newly-bundled extensions are inlined into the binary
        working-directory: bun-apps/pi-agent
        run: |
          set -e
          # "obsidian_list" is a tool NAME string literal registered inside
          # pi-agent-ext-obsidian's own implementation — it only appears if
          # obsidian's actual module body got inlined into the --compile binary.
          # The 5 new tool extensions (obsidian/btw/file2md/workflow/knowledge-
          # card) are DELIBERATELY bundled now (see src/static-extensions.ts),
          # so this string MUST be present — its absence would mean a static
          # import silently failed to inline. (Source-mode `ext doctor` above
          # proves the factories register; this proves they ship in the
          # single-file binary itself.)
          hits=$(strings ../../dist/pi-agent/pi-agent | grep -c "obsidian_list" || true)
          test "$hits" -gt 0 || { echo "obsidian's module body is NOT in the binary ($hits hits of 'obsidian_list') — static inlining of the new extensions regressed"; exit 1; }
          echo "obsidian inlined OK ($hits hits of 'obsidian_list')"

  # ──────────────────────────────────────────────────────────────────────────
  # Thrust B2 — clean-launch self-heal. Exercises the path that escaped CI when
  # the workspace root moved into bun-apps/ (#625): every other job runs
  # `setup-env` (which `bun install`s) BEFORE launching pi, so the launcher's
  # OWN pre-flight self-heal (run-dir/check-deps.ts → `bun install` at the
  # detected workspace root) was never exercised. A `git clean -dxf` +
  # `./pi-agent.sh` then failed: check-deps ran `bun install` at the repo root,
  # where package.json no longer lives → "could not find a package.json" →
  # unlinked @repo/* extension deps → jiti NameTooLong cascade. This job
  # reproduces that exact clean-checkout state: setup Bun but do NOT install,
  # then drive check-deps.ts directly and assert it installs at bun-apps/ and
  # exits 0. Also pins the #625 workspace-root location invariant. Always runs
  # (cheap; the invariant is repo-wide, not path-scoped).
  # ──────────────────────────────────────────────────────────────────────────
  clean-launch-self-heal:
    name: clean-launch self-heal
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      # Deliberately NOT ./.github/actions/setup-env — that pre-installs and
      # would hide the very regression this job guards.
      - name: Setup Bun (no install)
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.3.14"
      - name: Workspace-root location invariant (#625)
        run: |
          set -e
          # The workspace root lives at bun-apps/, NOT the repo root.
          test ! -e package.json || { echo "FAIL: package.json must not live at repo root"; exit 1; }
          test ! -e bun.lock    || { echo "FAIL: bun.lock must not live at repo root"; exit 1; }
          test -f bun-apps/package.json || { echo "FAIL: bun-apps/package.json missing"; exit 1; }
          test -f bun-apps/bun.lock      || { echo "FAIL: bun-apps/bun.lock missing"; exit 1; }
          echo "OK: workspace root is bun-apps/"
      - name: Fresh checkout has no node_modules (self-heal MUST trigger)
        run: |
          test ! -d bun-apps/node_modules || { echo "FAIL: node_modules pre-exists — clean-checkout premise broken"; exit 1; }
          echo "OK: clean tree — check-deps self-heal will run"
      - name: check-deps self-heal installs at bun-apps/ and exits 0
        run: |
          set -e
          # On a clean checkout, missingExtensionPackages() is non-empty →
          # check-deps runs `bun install` at its detected workspace root and
          # must exit 0. If anyone re-introduces a repo-root install assumption,
          # this fails with "could not find a package.json".
          bun bun-apps/pi-agent/run-dir/check-deps.ts
          test -d bun-apps/node_modules || { echo "FAIL: self-heal did not materialize bun-apps/node_modules"; exit 1; }
          echo "OK: self-heal installed at the workspace root (bun-apps/)"

  # ──────────────────────────────────────────────────────────────────────────
  # Thrust C — regression baselines. schema-cost (WARNING at >5%, not a block —
  # schema growth is sometimes intentional) + the 2 MB file-size guard (BLOCK —
  # the remote twin of .githooks/pre-commit, so a bypassed local hook can't ship
  # a large blob) + the test-portability audit (WARN-only v1 — surfaces new
  # ungated machine-coupled tests without blocking; see TEST-PORTABILITY.md).
  # ──────────────────────────────────────────────────────────────────────────
  regression-gates:
    name: regression gates
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup-env

      - name: File-size guard (2 MB, blocks)
        run: bash scripts/ci-file-size-guard.sh

      # Lockfile duplicate-version guard (blocks). The @earendil-works/*
      # family (pi-agent-core/pi-ai/pi-coding-agent/pi-tui) must resolve to
      # exactly one version across the whole workspace — a stray "*"/"^0.x"
      # range on one package.json lets bun.lock hoist a stale copy alongside
      # the pinned one, which `bun test` and `bun install --frozen-lockfile`
      # both miss (it's a semver-valid resolution) but tsc doesn't: two
      # resolved copies of the same class are two different types. Bit us
      # twice (#577, then again with pi-tui 0.80.6 vs 0.80.7) before this
      # existed. See scripts/check-lockfile-duplicate-versions.sh.
      - name: Lockfile duplicate-version guard (blocks)
        run: bash scripts/check-lockfile-duplicate-versions.sh

      # Lockfile freshness guard (blocks). #1586 added `yaml: ^2` to
      # pi-agent-core-interface's package.json without the matching bun.lock
      # workspace entry. With no edge recorded, `bun install` linked nothing,
      # and main went red on a runtime "Cannot find package 'yaml'" from
      # embedding-leaf.ts — a failure no typecheck could see.
      #
      # It is `bun install` + `git diff`, NOT `--frozen-lockfile`. Measured:
      # `bun install --frozen-lockfile` against the drifted lock exits 0. It
      # verifies that the lock's own resolutions are installable, not that the
      # lock still reflects every package.json. Only re-resolving and diffing
      # catches a workspace block that is missing a declared dependency.
      #
      # Stated here rather than in setup-env because local_ci derives its gate
      # list from THIS job's `run:` steps, and local_ci is the only CI that
      # actually executes (this workflow is .disabled).
      #
      # The check lives in a script, not inline: its message needs a `: ` and
      # its failure branch needs braces, which a YAML plain scalar cannot hold,
      # and ci-gates.ts joins a multi-line `run:` block's newlines with spaces —
      # turning two commands into one malformed one. Both shapes were tried and
      # both went red for reasons unrelated to the lockfile.
      # See scripts/check-lockfile-freshness.sh for why it is not
      # `--frozen-lockfile` (measured: that exits 0 on the exact drift).
      - name: Lockfile freshness guard (package.json vs bun.lock, blocks)
        run: bash scripts/check-lockfile-freshness.sh

      # Dependency-direction + import-hygiene guard (ADR-monorepo-0001, blocks). The
      # remote twin of `bun run test:deps` — 5 invariants over every @repo/*
      # import in bun-apps/*: declared deps, no self-import, knowledge-layer
      # TIER-0 (obsidian/hermes-memory) imports NOTHING from TIER-1
      # (knowledge-card), no extension imports the host, acyclic graph. Without
      # this step the upward hermes→hub edge ADR-monorepo-0001 removed could be
      # reintroduced and ship green — the test existed locally but nothing in
      # CI ran it (bun-apps/tests/ lives outside every per-package matrix entry).
      - name: Dependency-direction guard (ADR-monorepo-0001, blocks)
        working-directory: bun-apps
        run: bun run test:deps

      # ADR identity + citation guard (blocks). Contexts number their ADRs
      # independently from 0001, so the bare number 0001 names seven documents
      # and every number in use collides at least twice. #1323 resolved such a
      # bare citation to the wrong ADR, called a real dep-guard failure a false
      # positive, and allowlisted the violation — the gate above was defeated by
      # an ambiguous citation, not by a bad rule. This guard makes every ADR declare a
      # path-derived unique ID, keeps bun-apps/docs/adr/INDEX.md in sync with
      # disk BOTH ways, and fails any citation in live source/docs that does not
      # resolve to exactly one ADR (including references to numbers a context
      # has never had — five wayfind files and one superpowers file had those).
      - name: ADR identity + citation guard (blocks)
        working-directory: bun-apps
        run: bun run test:adr

      # Cross-skill reference guard (blocks). Skills defer to each other by
      # `<package>:<skill>` rather than restating rules — #1682 built five
      # wayfind pointer blocks on top of superpowers:dispatch-recovery that way.
      # Rename the target and every pointer becomes a dead end in silence: 6 of
      # the 11 references cross a package boundary, and a package suite only
      # ever sees its own skills/ dir, so neither side can catch it alone.
      - name: Cross-skill reference guard (blocks)
        working-directory: bun-apps
        run: bun run test:skills-ref

      # Dead-export guard (blocks). An exported value that nothing in the
      # workspace references is misinformation: it tells a reader a code path
      # exists. Sweep 2026-08-19 found 42, including a `clearSession` whose doc
      # claimed the session_shutdown wiring that a different function owned.
      - name: Dead-export guard (blocks)
        working-directory: bun-apps
        run: bun run test:dead-export

      # Cross-extension seam-contract guard (ADR-wayfind-0004). The
      # status-widget seam (__piCoreTaskStatusWidget) is duplicated across
      # ext-task (publisher) + wayfind/power-tool (consumers) with no
      # compile-time link — each side's tests mock its own literal, so a
      # rename/reshape in ext-task stays green and breaks consumers only in
      # production. This static source-analysis guard turns that silent drift
      # loud (key agreement + consumer-declared methods ⊆ publisher class).
      # No runtime import of any package — respects ADR-wayfind-0004's decoupling.
      - name: Cross-extension seam-contract guard (status widget, blocks)
        working-directory: bun-apps
        run: bun run test:seam

      # Cross-extension routing-contract guard (ticket 05). superpowers'
      # using-superpowers bootstrap names wayfind's skills (grilling/wayfind/
      # to-spec) in its pipeline-routing table. If wayfind renames/removes one,
      # the bootstrap silently teaches stale routing (no recovery net — the
      # agent misroutes). superpowers' own bootstrap.test.ts pins the
      # superpowers-side; this static guard closes the wayfind-side gap: every
      # routing-referenced wayfind skill must exist in wayfind/skills/ AND still
      # appear in the bootstrap source. No runtime import.
      - name: Cross-extension routing-contract guard (bootstrap ↔ wayfind, blocks)
        working-directory: bun-apps
        run: bun run test:routing

      # Config-field parity guard (ticket 03 — self-reflection frontier).
      # pi-agent-ext-hermes-memory's loadConfig is a selective per-field copy; a
      # field added to MemoryConfig (types.ts) but omitted in loadConfig is
      # SILENTLY DROPPED — a config-file value is ignored, masked by the
      # consumer's `config.X ?? envOrDefault()` fallback. This static guard turns
      # that silent drop loud (every top-level field read as parsed.<field>, or
      # explicitly allowlisted). Registry structure — add another config-bearing
      # package as a one-line entry. No runtime import.
      - name: Config-field parity guard (hermes loadConfig, blocks)
        working-directory: bun-apps
        run: bun run test:config-parity

      # Regression test for the test-portability audit itself (ticket 01 —
      # self-reflection). The audit is a CI gate but had no tests of its own;
      # this pins its --root flag + P-class classification (GUARDED vs UNGATED,
      # block-under-strict) via synthetic fixtures, so a refactor can't silently
      # disable a detection class.
      - name: Test-portability audit regression test
        working-directory: bun-apps
        run: bun run test:portability-audit

      # CI-workflow reference guard (blocks). The executor for a class that has
      # none: a reference inside a DISABLED workflow is never run, so it rots
      # silently (scripts/ci-changed-packages.sh was deleted while this file kept
      # calling it; the matrix carried a row for the deleted pi-agent-ext-picker;
      # pi-agent-core-runtime was created by #1251 and never got a row).
      # Asserts: every matrix row names a real package, every path this workflow
      # shells out to resolves, and every bun-apps/* package has a matrix row.
      # Reads the matrix through scripts/ci-local.sh --tsv — the ONE parser — so
      # no second copy of the matrix can drift.
      - name: CI-workflow reference guard (matrix ↔ tree, blocks)
        working-directory: bun-apps
        run: bun run test:ci-workflow

      # Package-script runnability guard (blocks). The same rot class as the
      # step above, hosted in package.json instead of this file: a script that
      # names a binary its package does not declare. Under the isolated linker
      # that script exits 127, and since only 3 of the 10 `check` scripts are
      # chained into a CI command, nothing ever ran them — perf-harness's
      # `tsc --noEmit` (no devDependencies at all) and pi-agent-core-runtime's
      # `biome check .` (no @biomejs/biome) both sat broken. Also asserts every
      # biome user HAS a biome.json — core-runtime's was left behind when #1251
      # extracted it from subagent, so biome silently graded against its own
      # defaults and reported 27 phantom format errors.
      - name: Package-script runnability guard (bare binaries, blocks)
        working-directory: bun-apps
        run: bun run test:scripts

      # Workspace dist-freshness guard (blocks) — TRIPWIRE form since the
      # 2026-08-15 src-entry migration (.planning/2026-08-15-src-entry-migration/):
      # all four former dist-root packages (workflow, superpowers, wayfind,
      # webui) resolve to ./src/index.ts, the bug class the original gate
      # patrolled (stale gitignored dist → cryptic jiti NameTooLong at boot,
      # cf6f1394 incident) is retired at the habitat, and the boot heal patch
      # (ensure-workspace-dist) is deleted. The gate now asserts ZERO @repo/*
      # packages resolve their root into ./dist/ — a re-added one resurrects
      # the whole class and is a regression, not a staleness to build away.
      # Detection lives in ONE place (pi-agent/src/workspace-dist-staleness.ts).
      - name: Workspace dist-freshness guard (blocks)
        working-directory: bun-apps
        run: bun run test:dist

      # Deploy-bundle guard (blocks). `bun run deploy` produces the shipped
      # artifact, and it was broken from #1544 through 90 commits of main with
      # nothing to say so: the jobs that build a bundle (deploy-verify,
      # compile-verify) sit in this workflow but Actions does not run here, and
      # local_ci — the only CI that executes — reads the regression-gates job
      # alone. A shipping artifact needs a gate in THIS job or it has none.
      # All three shipped modes, build AND boot (~4s); boot smokes use a throwaway
      # PI_CODING_AGENT_DIR so it never touches shared ~/.pi state.
      - name: Deploy-artifact guard (bundle + exe + snapshot, blocks)
        run: bash scripts/check-deploy-artifacts.sh

      # Extension-entry typecheck-coverage guard (blocks). An extension package's
      # registration entry lives at extensions/<X>.ts while its source lives in
      # src/ — and most of these packages wrote `include: ["src/**/*.ts"]`, so
      # `bun run typecheck` inside the package compiled everything EXCEPT the one
      # file the package exists to export. The entry still had an executor, just
      # the wrong one: the HOST pi-agent typechecks it through run-dir/manifest.json.
      # So the author's own pre-push gate said nothing and the failure surfaced one
      # package away, on main, after merge — twice. This asserts each package with
      # an extensions/ dir has a tsconfig, that its `include` covers every entry,
      # and that some script actually invokes tsc (coverage with no executor reads
      # as fixed and is not — cf. the package-script runnability guard above).
      - name: Extension-entry typecheck coverage (blocks)
        working-directory: bun-apps
        run: bun run test:ext-entry

      # …and the executor for it. The guard above proves each package CAN
      # typecheck its entry; this is what makes CI actually do it. Needed because
      # the per-package matrix gives most of these a plain `bun test`, which never
      # chains typecheck — so without this step the guard would be green while the
      # entry files stayed uncompiled, which is the failure it exists to prevent.
      - name: Extension-entry typecheck (executor, blocks)
        working-directory: bun-apps
        run: bun run typecheck:ext

      # Test-portability prevention check — now BLOCKING (--strict). Scans the
      # test surface for the four "works on my machine" signal patterns and
      # exits non-zero on any UNGATED P1/P2 hit (existsSync of a machine-coupled
      # path; spawn/exec of a host binary). P3/P4 stay review-only. Green across
      # #384–#391 warranted the flip from warn-only; a NEW ungated machine-
      # coupled test now blocks the merge. See .github/TEST-PORTABILITY.md.
      - name: Test-portability audit (--strict, blocks)
        run: bash scripts/test-portability-audit.sh --strict

      # Test-determinism prevention check — now BLOCKING (--strict). The
      # cross-RUN twin of the portability audit: scans for the four flake
      # classes (uncontrolled time; real host-state writes; cross-file ordering;
      # live network) and classifies each file CONTROLLED / UNCONTROLLED. Only
      # D2 (real host-state writes) blocks; D1/D4 stay review-only (a Date.now()
      # is often a benign seed; a URL string isn't a live call).
      #
      # Flipped 2026-08-18, the condition its own v1 comment set ("once
      # trusted"). Warn-only was never going to earn that on its own: this gate
      # ran without --strict, so the exit code it produced could not distinguish
      # a clean tree from a dirty one — measured 0 either way. What justified the
      # flip is that --strict exits 0 on main today, and that the check is a
      # static scan of the test surface: deterministic given the tree, with no
      # flake channel of its own. Verified by mutation — a test writing to
      # ~/.pi/ under a write-op makes it exit 1 and name the file.
      # See .github/TEST-DETERMINISM.md for the full catalog + dispositions.
      - name: Test-determinism audit (D2 --strict, blocks)
        run: bash scripts/test-determinism-audit.sh --strict

      # Decision tests for the PR-finish flow — the bash script was ported
      # into pi-agent-ext-devops (bin devops-pr-finish), so the tests moved
      # into the ext package. No live PR needed — fake gh + stubbed runCi.
      - name: PR-finish decision tests (devops-pr-finish)
        working-directory: bun-apps/pi-agent-ext-devops
        run: bun test tests/pr-finish-cli.test.ts

      - name: Schema-cost regression (warns >5%, not a block)
        run: bun scripts/check-schema-cost.ts

      - name: Declared-imports audit (warn-only v1)
        run: node scripts/check-declared-imports.mjs

  # ──────────────────────────────────────────────────────────────────────
  # Thrust C — determinism spot-check (cross-RUN flake detector). Runs the
  # flake-prone subset (see the `package` matrix below — the same list lives in
  # scripts/test-determinism-spotcheck.sh, and a guard test pins them equal)
  # 3× in sequence and flags any differing pass/fail outcome as a flake. v1 is
  # INFORMATIONAL (continue-on-error) until the false-positive rate is ≈ 0; flip
  # to blocking once trusted — same rollout discipline as the portability audit.
  # The structural audit (test-determinism-audit.sh) is the proof; this is the
  # detection backstop. See .github/TEST-DETERMINISM.md.
  #
  # Path-gated via changed_packages, same mechanism as the `tests` matrix
  # above: a PR that doesn't touch one of these 3 packages (directly or via
  # a @repo/* dependency edge) no-ops that package's steps instead of paying
  # for 3× its test command. Push-to-main always runs everything.
  # ──────────────────────────────────────────────────────────────────────
  determinism-spotcheck:
    name: determinism · ${{ matrix.package }}
    needs: changed_packages
    runs-on: ubuntu-latest
    timeout-minutes: 6
    continue-on-error: true
    # Matrix the 3 flake-prone packages into PARALLEL runner jobs instead of
    # running them serially in one job. Each job runs its package's test command
    # 3× (REPEATS=3) and flags any differing outcome as a flake. Why matrix over
    # script-level backgrounding: the workflow package rebuilds its gitignored
    # dist/ as part of its command, which would race with sibling packages that
    # import from it if they shared a runner. Separate runners = separate
    # checkouts, no shared-writable state. The check name changes from a single
    # "determinism spot-check" to 3 "determinism · <package>" rows — fine for an
    # informational (continue-on-error) job; revisit if/when this flips blocking.
    strategy:
      fail-fast: false
      matrix:
        package:
          - pi-agent-ext-hermes-memory
          - pi-agent-ext-workflow
          - pi-agent-ext-obsidian
          # Added after a full local-matrix run failed once ("examples re-renders
          # every bundled example IR to HTML" expected >=5, got 0) and then went
          # green 6+ times on identical code. The test asserts a DELTA in the real
          # vendored/examples/ dir, so it is cross-RUN coupled by construction.
          # Observe it here rather than diagnose it by guesswork. The package list
          # in scripts/test-determinism-spotcheck.sh must match this one — a guard
          # test asserts that.
          - pi-agent-ext-archify
    steps:
      # "should this instance's steps actually run" — same gate as the `tests`
      # matrix above (see that job's steps comment for why this can't move to
      # a job-level `if:` — `matrix` isn't available there).
      - uses: actions/checkout@v4
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
      # All three flake-prone packages now run under `bun test` (hermes-memory
      # dropped its Node/tsx carve-out), so no Node setup is needed here.
      - uses: ./.github/actions/setup-env
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
      - name: Determinism spot-check (3× ${{ matrix.package }})
        if: "!cancelled() && (github.event_name == 'push' || needs.changed_packages.result != 'success' || fromJSON(needs.changed_packages.outputs.packages)[matrix.package] == true)"
        run: bash scripts/test-determinism-spotcheck.sh "${{ matrix.package }}"
